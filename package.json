{
  "name": "repo-remote-inventory",
  "displayName": "Repo Remote Inventory",
  "description": "Inspect local Git repositories and their remote branches from a VS Code sidebar.",
  "icon": "resources/extension-icon.png",
  "version": "0.3.0",
  "publisher": "brian-chang",
  "repository": { "type": "git", "url": "https://github.com/BrianChang1212/repo-remote-inventory.git" },
  "license": "MIT",
  "engines": { "vscode": "^1.90.0" },
  "extensionKind": ["ui"],
  "categories": ["Other"],
  "activationEvents": ["onView:repoRemoteInventory.repositories"],
  "main": "./source/extension.js",
  "l10n": "./l10n",
  "scripts": {
    "test": "node --test test/*.test.js",
    "package:verify": "node tool/package-verify.js"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0",
    "yauzl": "^3.4.0"
  },
  "files": ["source/", "resources/", "l10n/", "package.nls.json", "package.nls.zh-tw.json", "README.md", "CHANGELOG.md", "LICENSE", "CONTRIBUTING.md", "SECURITY.md"],
  "capabilities": { "untrustedWorkspaces": { "supported": false, "description": "%capability.untrustedWorkspaces.description%" } },
  "contributes": {
    "commands": [
      { "command": "repoRemoteInventory.refreshAll", "title": "%command.refreshAll.title%", "icon": "$(refresh)" },
      { "command": "repoRemoteInventory.refreshRepository", "title": "%command.refreshRepository.title%", "icon": "$(refresh)" },
      { "command": "repoRemoteInventory.chooseRoot", "title": "%command.chooseRoot.title%" },
      { "command": "repoRemoteInventory.chooseList", "title": "%command.chooseList.title%" },
      { "command": "repoRemoteInventory.toggleAutoRefresh", "title": "%command.toggleAutoRefresh.title%", "icon": "$(circle-slash)" },
      { "command": "repoRemoteInventory.enableAutoRefresh", "title": "%command.enableAutoRefresh.title%", "icon": "$(sync)" },
      { "command": "repoRemoteInventory.openDashboard", "title": "%command.openDashboard.title%", "icon": "$(graph)" },
      { "command": "repoRemoteInventory.dashboardRefresh", "title": "%command.dashboardRefresh.title%", "icon": "$(refresh)" }
    ],
    "viewsContainers": { "activitybar": [{ "id": "repoRemoteInventory", "title": "%viewsContainer.repoRemoteInventory.title%", "icon": "resources/inventory.svg" }] },
    "views": { "repoRemoteInventory": [{ "id": "repoRemoteInventory.repositories", "name": "%view.repositories.name%", "type": "webview" }] },
    "menus": {
      "view/title": [
        { "command": "repoRemoteInventory.refreshAll", "when": "view == repoRemoteInventory.repositories", "group": "navigation@1" },
        { "command": "repoRemoteInventory.toggleAutoRefresh", "when": "view == repoRemoteInventory.repositories && repoRemoteInventory.autoMode", "group": "navigation@2" },
        { "command": "repoRemoteInventory.enableAutoRefresh", "when": "view == repoRemoteInventory.repositories && !repoRemoteInventory.autoMode", "group": "navigation@2" },
        { "command": "repoRemoteInventory.openDashboard", "when": "view == repoRemoteInventory.repositories", "group": "navigation@3" }
      ],
      "webview/title": [{ "command": "repoRemoteInventory.dashboardRefresh", "when": "webviewId == repoRemoteInventory.dashboard", "group": "navigation" }]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "repoRemoteInventory.autoRefreshOnOpen": { "type": "boolean", "scope": "application", "default": true, "description": "%config.autoRefreshOnOpen.description%" },
        "repoRemoteInventory.listFile": { "type": "string", "default": "", "description": "%config.listFile.description%" },
        "repoRemoteInventory.rootPath": { "type": "string", "default": "", "description": "%config.rootPath.description%" },
        "repoRemoteInventory.excludePaths": { "type": "array", "items": { "type": "string" }, "default": ["node_modules", ".venv"], "description": "%config.excludePaths.description%" },
        "repoRemoteInventory.maxParallel": { "type": "integer", "default": 8, "minimum": 1, "maximum": 32, "description": "%config.maxParallel.description%" },
        "repoRemoteInventory.timeoutSeconds": { "type": "integer", "default": 20, "minimum": 1, "maximum": 120, "description": "%config.timeoutSeconds.description%" }
      }
    }
  }
}
