{
  "name": "repo-remote-inventory",
  "displayName": "Repo Remote Inventory",
  "description": "Inspect local Git repositories and their remote branches from a VS Code sidebar.",
  "icon": "resources/extension-icon.png",
  "version": "0.1.0",
  "publisher": "brian-chang",
  "license": "MIT",
  "engines": { "vscode": "^1.90.0" },
  "extensionKind": ["ui"],
  "categories": ["Other"],
  "activationEvents": ["onView:repoRemoteInventory.repositories"],
  "main": "./source/extension.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "package:verify": "node tool/package-verify.js"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0",
    "yauzl": "^3.4.0"
  },
  "files": ["source/", "resources/", "README.md", "CHANGELOG.md", "LICENSE", "CONTRIBUTING.md", "SECURITY.md"],
  "capabilities": { "untrustedWorkspaces": { "supported": false, "description": "Scanning repositories runs the local Git executable." } },
  "contributes": {
    "commands": [
      { "command": "repoRemoteInventory.refreshAll", "title": "Repo Remote Inventory: Refresh All", "icon": "$(refresh)" },
      { "command": "repoRemoteInventory.refreshRepository", "title": "Repo Remote Inventory: Refresh Repository", "icon": "$(refresh)" },
      { "command": "repoRemoteInventory.chooseRoot", "title": "Repo Remote Inventory: Choose Scan Directory" },
      { "command": "repoRemoteInventory.chooseList", "title": "Repo Remote Inventory: Choose Repository List" }
    ],
    "viewsContainers": { "activitybar": [{ "id": "repoRemoteInventory", "title": "Repo Inventory", "icon": "resources/inventory.svg" }] },
    "views": { "repoRemoteInventory": [{ "id": "repoRemoteInventory.repositories", "name": "Repositories" }] },
    "menus": {
      "view/title": [{ "command": "repoRemoteInventory.refreshAll", "when": "view == repoRemoteInventory.repositories", "group": "navigation" }],
      "view/item/context": [{ "command": "repoRemoteInventory.refreshRepository", "when": "view == repoRemoteInventory.repositories && viewItem == repository", "group": "inline" }]
    },
    "configuration": {
      "title": "Repo Remote Inventory",
      "properties": {
        "repoRemoteInventory.autoRefreshOnOpen": { "type": "boolean", "default": true, "description": "Refresh online when the inventory view opens." },
        "repoRemoteInventory.listFile": { "type": "string", "default": "", "description": "Path to a repo_paths.json-compatible list. Empty uses recursive discovery." },
        "repoRemoteInventory.rootPath": { "type": "string", "default": "", "description": "Root directory for relative list paths or recursive discovery. Empty uses the open workspace folder." },
        "repoRemoteInventory.excludePaths": { "type": "array", "items": { "type": "string" }, "default": ["node_modules", ".venv"], "description": "Directory names or root-relative paths to exclude from discovery." },
        "repoRemoteInventory.maxParallel": { "type": "integer", "default": 8, "minimum": 1, "maximum": 32, "description": "Maximum simultaneous Git remote queries." },
        "repoRemoteInventory.timeoutSeconds": { "type": "integer", "default": 20, "minimum": 1, "maximum": 120, "description": "Timeout for each remote query." }
      }
    }
  }
}
